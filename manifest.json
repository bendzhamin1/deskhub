{
  "manifest_version": 3,
  "name": "DeskHub",
  "version": "0.1.4",
  "description": "Папки и сортировка закладок на новой вкладке: кастомизация интерфейса и синхронизация рабочего пространства",

  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://suggestqueries.google.com/*",
    "https://duckduckgo.com/*",
    "https://www.google.com/*",
    "https://lens.google.com/*"
  ]
}
