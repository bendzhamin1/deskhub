{
  "manifest_version": 3,
  "name": "DeskHub",
  "version": "0.1.7",
  "description": "__MSG_extDescription__",
  "default_locale": "en",

  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },

  "permissions": [
    "storage",
    "search"
  ]
}
